<Window x:Class="SwiftSandbox.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Swift Sandbox" Width="1160" Height="740" MinWidth="900" MinHeight="570" WindowStartupLocation="CenterScreen" Background="#0D0E14">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="25"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#151620" BorderBrush="#2A2C3A" BorderThickness="0,0,0,1">
      <DockPanel Margin="20,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
          <Border Width="30" Height="30" CornerRadius="9" Background="#9E72F5"><TextBlock Text="S" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/></Border>
          <TextBlock Text="SWIFT" FontSize="16" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
          <TextBlock Text="SANDBOX" FontSize="11" FontWeight="SemiBold" Foreground="#9E72F5" Margin="9,2,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center">
          <Border CornerRadius="10" Background="#24362F" Padding="9,4" Margin="0,0,13,0"><TextBlock Text="●  LOCAL DEMO" FontSize="10" FontWeight="Bold" Foreground="#81D6A0"/></Border>
          <TextBlock Text="Luau-style editor" Foreground="#9193A7" FontSize="12" VerticalAlignment="Center"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#151620" BorderBrush="#2A2C3A" BorderThickness="0,0,1,0">
        <Grid Margin="14,17"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel><TextBlock Text="EXPLORER" Foreground="#9193A7" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/><Button x:Name="NewButton" Content="+" Width="28" Height="28" Padding="0" HorizontalAlignment="Right" DockPanel.Dock="Right" Click="NewButton_Click" ToolTip="New tab"/></DockPanel>
          <TextBlock Grid.Row="1" Text="BUILT-IN SCRIPTS" Foreground="#9E72F5" FontSize="10" FontWeight="Bold" Margin="8,25,0,8"/>
          <ListBox Grid.Row="2" x:Name="BuiltInList" SelectionChanged="BuiltInList_SelectionChanged"/>
          <Grid Grid.Row="3" Margin="0,24,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="SAVED SCRIPTS" Foreground="#9E72F5" FontSize="10" FontWeight="Bold" Margin="8,0,0,8"/><ListBox Grid.Row="1" x:Name="SavedList" SelectionChanged="SavedList_SelectionChanged"/></Grid>
          <Border Grid.Row="4" Background="#202131" CornerRadius="7" Padding="10" Margin="0,10,0,0"><TextBlock Text="Scripts run in a limited local demo. No game connection." TextWrapping="Wrap" Foreground="#A8A6BA" FontSize="11"/></Border>
        </Grid>
      </Border>
      <Grid Grid.Column="1" Margin="19,17,19,13">
        <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="150"/><RowDefinition Height="48"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="TabsPanel" Orientation="Horizontal"/></ScrollViewer></DockPanel>
        <Border Grid.Row="1" Background="#151620" BorderBrush="#2A2C3A" BorderThickness="1" CornerRadius="8" Margin="0,7,0,10">
          <Grid><Grid.RowDefinitions><RowDefinition Height="35"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="#1B1D29" CornerRadius="8,8,0,0" BorderBrush="#2A2C3A" BorderThickness="0,0,0,1"><DockPanel Margin="14,0"><TextBlock x:Name="EditorTitle" Text="Untitled.luau" VerticalAlignment="Center" FontSize="12" Foreground="#AAAABD"/><TextBlock Text="LUAU" HorizontalAlignment="Right" VerticalAlignment="Center" DockPanel.Dock="Right" FontSize="10" FontWeight="Bold" Foreground="#77798D"/></DockPanel></Border>
            <RichTextBox Grid.Row="1" x:Name="Editor" Background="Transparent" Foreground="#E8E8F2" BorderThickness="0" Margin="11,5,0,0" Padding="6" FontFamily="Cascadia Code, Consolas" FontSize="14" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" SpellCheck.IsEnabled="False" TextChanged="Editor_TextChanged"/>
          </Grid>
        </Border>
        <Border Grid.Row="2" Background="#151620" BorderBrush="#2A2C3A" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10">
          <Grid><Grid.RowDefinitions><RowDefinition Height="33"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="#1B1D29" CornerRadius="8,8,0,0" BorderBrush="#2A2C3A" BorderThickness="0,0,0,1"><DockPanel Margin="13,0"><TextBlock Text="OUTPUT" FontSize="10" FontWeight="Bold" Foreground="#9E72F5" VerticalAlignment="Center"/><Button x:Name="ClearOutputButton" Content="Clear output" FontSize="10" Padding="7,3" HorizontalAlignment="Right" DockPanel.Dock="Right" Click="ClearOutputButton_Click"/></DockPanel></Border><TextBox x:Name="OutputBox" Grid.Row="1" Background="Transparent" Foreground="#C9CAD6" FontFamily="Cascadia Code, Consolas" FontSize="12" BorderThickness="0" Margin="13,8" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Grid>
        </Border>
        <DockPanel Grid.Row="3"><StackPanel Orientation="Horizontal" HorizontalAlignment="Left" DockPanel.Dock="Left"><Button x:Name="RunButton" Content="▶  Execute" Background="#8B5CE5" BorderBrush="#8B5CE5" FontWeight="Bold" MinWidth="105" Click="RunButton_Click"/><Button Content="Clear" Margin="9,0,0,0" MinWidth="68" Click="ClearButton_Click"/><Button Content="Save" Margin="9,0,0,0" MinWidth="68" Click="SaveButton_Click"/><Button Content="Open" Margin="9,0,0,0" MinWidth="68" Click="OpenButton_Click"/></StackPanel><TextBlock x:Name="StatusText" Text="Ready" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#9193A7" FontSize="11" DockPanel.Dock="Right"/></DockPanel>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="#151620" BorderBrush="#2A2C3A" BorderThickness="0,1,0,0"><DockPanel Margin="17,0"><TextBlock Text="SWIFT SANDBOX 1.0" VerticalAlignment="Center" Foreground="#77798D" FontSize="10"/><TextBlock Text="LOCAL ONLY  •  NO ROBLOX ATTACHMENT" HorizontalAlignment="Right" VerticalAlignment="Center" DockPanel.Dock="Right" Foreground="#77798D" FontSize="10"/></DockPanel></Border>
  </Grid>
</Window>

